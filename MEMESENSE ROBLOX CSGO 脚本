            hl.unvisible.FillColor          = colUnvisible
            hl.unvisible.OutlineColor       = colUnvisible
            hl.unvisible.FillTransparency   = fillAlphaUnvis
            hl.unvisible.OutlineTransparency= outAlphaUnvis
